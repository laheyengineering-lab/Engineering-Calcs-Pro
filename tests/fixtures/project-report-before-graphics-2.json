    {
      "id": "emwrfrnlxapbz9e",
      "calculatorId": "hertzian-contact",
      "calculatorName": "Hertzian Contact Stress",
      "path": "calculators/hertzian-contact.html",
      "title": "Hertzian point contact (spheres)",
      "addedAt": "2026-11-22T06:08:36.165Z",
      "notes": "",
      "inputs": [
        {"label": "Configuration", "value": "Two spheres (point contact)", "unit": ""},
        {"label": "Body 1 diameter", "value": 50, "unit": "mm"},
        {"label": "Body 2 shape", "value": "Convex body", "unit": ""},
        {"label": "Body 2 diameter", "value": 50, "unit": "mm"},
        {"label": "Contact force (F)", "value": 1000, "unit": "N"},
        {"label": "Body 1 Young's modulus (E₁)", "value": 200, "unit": "GPa"},
        {"label": "Body 1 Poisson's ratio (ν₁)", "value": 0.3, "unit": ""},
        {"label": "Body 2 Young's modulus (E₂)", "value": 200, "unit": "GPa"},
        {"label": "Body 2 Poisson's ratio (ν₂)", "value": 0.3, "unit": ""}
      ],
      "outputs": [
        {"label": "Effective elastic modulus (E*)", "value": 109890.10989010989, "unit": "MPa"},
        {"label": "Equivalent radius (R)", "value": 12.5, "unit": "mm"},
        {"label": "Contact radius (a)", "value": 0.4402211353995258, "unit": "mm"},
        {"label": "Approach of centres (δ)", "value": 0.01550357184419581, "unit": "mm"},
        {"label": "Maximum contact pressure (p_max)", "value": 2463.766848434675, "unit": "MPa"},
        {"label": "Mean contact pressure", "value": 1642.5112322897835, "unit": "MPa"},
        {"label": "Approx. maximum shear stress (ν ≈ 0.3)", "value": 763.7677230147493, "unit": "MPa"},
        {"label": "Depth of maximum shear", "value": 0.2113061449917724, "unit": "mm"}
      ],
      "equations": [
        "\\frac{1}{E^*} = \\frac{1-\\nu_1^2}{E_1} + \\frac{1-\\nu_2^2}{E_2} \\qquad \\frac{1}{R} = \\frac{1}{R_1} \\pm \\frac{1}{R_2}",
        "a = \\left(\\frac{3 F R}{4 E^*}\\right)^{1/3} \\qquad p_{max} = \\frac{3F}{2\\pi a^2} \\qquad \\delta = \\frac{a^2}{R}"
      ],
      "assumptions": [
        "Linear elastic, isotropic, homogeneous bodies; contact dimensions small compared with the body radii",
        "Frictionless contact surfaces; normal load only (no tangential or rolling traction)",
        "Smooth surfaces; no roughness, coating, residual stress or lubricant film effects",
        "Static load; no dynamic, impact or thermal effects",
        "Cylinders: parallel axes, plane-strain line contact, length L much larger than the contact width and uniform load along L (no edge or crowning effects)",
        "Spheres: point contact between spheres of uniform radius (a flat plate is a sphere of infinite radius)",
        "Maximum contact pressure is not a fatigue, wear, yield or service-life assessment"
      ],
      "method": "Hertz point contact of two spheres: contact radius from the equivalent radius and effective modulus, with a semi-ellipsoidal pressure distribution.",
      "diagram": {
        "type": "calc-diagram",
        "id": "hertzian-contact",
        "model": {
          "config": "spheres",
          "shape2": "convex",
          "d1": 50,
          "d2": 50,
          "distanceUnit": "mm",
          "force": 1000,
          "forceUnit": "N"
        }
      },
      "warnings": [
        "Maximum contact pressure is not a fatigue, wear, yielding or service-life assessment.",
        "Shear-stress values use ν ≈ 0.3 coefficients and are approximate."
      ]
    },
    {
      "id": "emwrfrnnug52yis",
      "calculatorId": "fillet-weld",
      "calculatorName": "Fillet Weld Strength Calculator",
      "path": "calculators/fillet-weld.html",
      "title": "Fillet Weld Strength Calculator",
      "addedAt": "2026-11-22T06:08:36.234Z",
      "notes": "",
      "inputs": [
        {"label": "Weld Leg Size (w)", "value": "0.25", "unit": "in"},
        {"label": "Total Effective Weld Length (L)", "value": "12", "unit": "in"},
        {"label": "Electrode (FEXX)", "value": "E70XX (70 ksi ≈ 483 MPa)", "unit": ""},
        {"label": "Load Direction", "value": "90° — Transverse", "unit": ""},
        {"label": "Design Method", "value": "LRFD (φ = 0.75)", "unit": ""},
        {"label": "Applied Load (optional)", "value": "12000", "unit": "lbf"}
      ],
      "outputs": [
        {"label": "Primary result", "value": "Design Capacity: 100,217.246 lbf", "unit": ""},
        {"label": "Effective Throat", "value": "0.17675 in", "unit": ""},
        {"label": "Effective Weld Area", "value": "2.121 in²", "unit": ""},
        {"label": "Nominal Weld Capacity (Rn)", "value": "133,622.994 lbf", "unit": ""},
        {"label": "LRFD φRn (φ = 0.75)", "value": "100,217.246 lbf", "unit": ""},
        {"label": "ASD Rn/Ω (Ω = 2.00)", "value": "66,811.497 lbf", "unit": ""},
        {"label": "Nominal Weld Stress (Fnw)", "value": "434.4 MPa", "unit": ""},
        {"label": "Applied Load", "value": "12,000 lbf", "unit": ""},
        {"label": "Required Weld Leg Size", "value": "0.02993 in", "unit": ""},
        {"label": "Utilization", "value": "0.12", "unit": ""},
        {"label": "Remaining Capacity", "value": "88,217.246 lbf", "unit": ""},
        {"label": "Status", "value": "PASS (weld-metal check only)", "unit": ""}
      ],
      "equations": [
        "t_e = 0.707\\,w \\qquad A_{we} = t_e L",
        "F_{nw} = 0.60\\,F_{EXX} \\quad (\\theta = 0^\\circ)",
        "F_{nw} = 0.60\\,F_{EXX}\\left(1 + 0.50\\sin^{1.5}\\theta\\right)",
        "R_n = F_{nw}A_{we} \\qquad \\phi R_n,\\ \\phi = 0.75 \\qquad \\frac{R_n}{\\Omega},\\ \\Omega = 2.00",
        "w_{req,LRFD} = \\frac{P}{\\phi F_{nw}(0.707)L} \\qquad w_{req,ASD} = \\frac{P\\,\\Omega}{F_{nw}(0.707)L}"
      ],
      "assumptions": [
        "Equal-leg 45° fillet geometry",
        "Direct loading through the weld-group centroid; no eccentric loading or weld-group moment",
        "Uniform effective throat; effective weld length supplied by the user",
        "Weld-metal strength calculation only; no base-metal failure check",
        "No minimum/maximum weld-size code check",
        "No fatigue check, residual-stress/distortion analysis, or fracture mechanics",
        "No block shear, local plate bending, groove-weld design, or AWS procedure qualification",
        "The applicable welding/design standard must be verified for the actual application"
      ],
      "method": "A fillet weld has an approximately triangular cross-section. Failure is governed by the effective throat, the shortest distance through the weld, which for an equal-leg 45° fillet is 0.707 times the leg size. Direct-load capacity is the weld-metal strength times the effective area (throat × length). The filler-metal classification strength \\(F_{EXX}\\) (e.g. E70XX = 70 ksi minimum tensile strength) is used rather than a base-material strength.",
      "diagram": {
        "type": "calc-diagram",
        "id": "fillet-weld",
        "model": {
          "leg": 0.25,
          "legUnit": "in",
          "length": 12,
          "lengthUnit": "in",
          "angle": 90,
          "load": 12000,
          "loadUnit": "lbf"
        }
      },
      "warnings": [
        "Captured from the calculator page display; values are shown as formatted on screen."
      ]
    },
