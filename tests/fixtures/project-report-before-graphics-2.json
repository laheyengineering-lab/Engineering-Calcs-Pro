        {"label": "Angle of twist (signed)", "value": -0.005723854097211023, "unit": "rad"},
        {"label": "Angle of twist (signed)", "value": -0.3279526823188556, "unit": "°"},
        {"label": "Torsional stiffness", "value": 52412.237437389704, "unit": "N·m/rad"}
      ],
      "equations": [
        "J_{\\mathrm{solid}}=\\frac{\\pi D^4}{32},\\quad J_{\\mathrm{hollow}}=\\frac{\\pi(D_o^4-D_i^4)}{32}",
