      "id": "emwrfrne4iw5o6u",
      "calculatorId": "beam-deflection",
      "calculatorName": "Beam Deflection",
      "path": "calculators/beam-deflection.html",
      "title": "Cantilever, point load at free end — Solid rectangle / square",
      "addedAt": "2026-11-22T06:08:35.884Z",
      "notes": "",
      "inputs": [
        {"label": "Loading / support case", "value": "Cantilever, point load at free end", "unit": ""},
        {"label": "Support configuration", "value": "Cantilever (fixed root, free end)", "unit": ""},
        {"label": "Beam span (L)", "value": 2, "unit": "m"},
        {"label": "Point load (P)", "value": -1000, "unit": "N"},
        {"label": "Young's modulus (E)", "value": 200, "unit": "GPa"},
        {"label": "Cross-section profile", "value": "Solid rectangle / square", "unit": ""},
        {"label": "Width (b)", "value": 100, "unit": "mm"},
        {"label": "Height (h)", "value": 100, "unit": "mm"},
        {"label": "Bending axis", "value": "horizontal x-axis (Iₓ)", "unit": ""}
      ],
      "outputs": [
        {"label": "Cross-sectional area (A)", "value": 10000.000000000002, "unit": "mm²"},
        {"label": "Centroid x̄", "value": 50, "unit": "mm"},
        {"label": "Centroid ȳ", "value": 50, "unit": "mm"},
        {"label": "Second moment of area (Iₓ)", "value": 8.333333333333335e-06, "unit": "m⁴"},
        {"label": "Second moment of area (Iᵧ)", "value": 8.333333333333335e-06, "unit": "m⁴"},
        {"label": "Selected second moment of area (I)", "value": 8.333333333333335e-06, "unit": "m⁴"},
        {"label": "Section modulus (Sₓ)", "value": 166666.6666666667, "unit": "mm³"},
        {"label": "Section modulus (Sᵧ)", "value": 166666.6666666667, "unit": "mm³"},
        {"label": "Maximum deflection (signed)", "value": -0.0015999999999999996, "unit": "m"},
        {"label": "Maximum deflection magnitude", "value": 0.0015999999999999996, "unit": "m"},
        {"label": "Maximum deflection location", "value": 2, "unit": "m"},
        {"label": "Maximum bending moment", "value": -2000, "unit": "N·m"},
        {"label": "Flexural rigidity (EI)", "value": 1666666.666666667, "unit": "N·m²"}
      ],
      "equations": [
        "A=bh,\\quad \\bar{x}=b/2,\\quad \\bar{y}=h/2,\\quad I_x=bh^3/12,\\quad I_y=hb^3/12",
        "\\delta_{\\max}=\\frac{PL^3}{3EI}"
      ],
      "assumptions": [
        "Linear-elastic homogeneous material, small deflection, prismatic beam and constant E and I.",
        "Euler–Bernoulli beam theory; shear deformation is neglected.",
        "Static full-span loading with ideal pin/roller or fixed-free supports, as specified by the selected case.",
        "The closed-form solution does not represent plasticity, buckling, connection flexibility, support settlement, or dynamic effects."
      ],
      "method": "The selected cross-section determines its centroidal inertia about the chosen bending axis. The corresponding closed-form Euler–Bernoulli beam solution is then evaluated using span, elastic modulus, and the selected point or uniform load.",
      "diagram": {
        "type": "beam-deflection",
        "caseId": "cant-point",
        "span": 2,
        "spanUnit": "m",
        "load": -1000,
        "loadUnit": "N",
        "profile": "rectangular",
        "dimensions": {
          "width": 0.1,
          "height": 0.1
        },
        "axis": "x",
        "sectionUnit": "m",
        "maxDeflection": 0.0015999999999999996,
        "deflectionUnit": "m"
      },
      "warnings": [
        "Use only for the listed load and support cases; partial or varying loads and non-ideal supports require a different model."
      ]
    },
